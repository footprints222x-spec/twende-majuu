# Copy to `.env` (development) or set these in your hosting dashboard (production).

# PRODUCTION ONLY: full URL of the Flask API, ending in /api.
# Leave empty in development: the site calls /api and Vite forwards it to Flask.
VITE_API_URL=

# DEVELOPMENT ONLY: where Flask is running (used by the Vite dev proxy).
DEV_API_TARGET=http://127.0.0.1:5000
